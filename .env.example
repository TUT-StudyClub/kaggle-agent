# CLIが直接読み込みます。環境変数が優先されます。
# 実トークンと実IDは.gitignore対象の.envにだけ記入してください。
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
NOTION_TOKEN=

TEAM_ID=T_REPLACE
# 配列とオブジェクトはJSON形式で記述します。
USER_IDS='["U_REPLACE"]'
# DMの会話IDも明示的に登録します。
CHANNEL_IDS='["C_REPLACE","D_REPLACE"]'
NOTION_PAGES='[]'
NOTION_DATA_SOURCES='[]'
# 参加中コンペの情報源。Competition DBのdata source IDを指定します。
NOTION_COMPETITION_DATA_SOURCE_ID=
NOTION_PARENTS='{"notes":"00000000-0000-0000-0000-000000000001"}'
CALENDARS='{"personal":{"id":"REPLACE@group.calendar.google.com","writable":true}}'

# 毎日のチーム予定通知（nullで無効）。色ではなくラベルIDで対象を限定します。
# channel_idはCHANNEL_IDS、calendar_aliasはCALENDARSに登録したものを指定します。
# 例: {"calendar_alias":"personal","label_id":"ラベルID","channel_id":"C_REPLACE"}
# 省略時は毎日10:00（日本時間）。hour / minuteで変更できます。
# 招待した本人（creator）＋招待ゲストが通知先の人間全員なら@channel、
# 一部なら該当者だけをメンションします。会議室などのリソースは除きます。
# Member DBのCalendar Emails（rich_text）に対応するメールを登録してください。
# 複数アドレスはカンマ・改行区切り。未対応・取得不完全の場合は送信せずログに記録します。
# users:readを含むマニフェストでSlack Appを再インストールしてください。
DAILY_SCHEDULE_REMINDER='null'

# Member DBを使用する場合はCALENDARSの対象カレンダーに
# "member_data_source_id":"Member DBのdata source ID" を追加します。
# Member DB未使用時だけ "label_users":{"取得したラベルID":"U1234567890"} を設定できます。
# 同時指定はできません。Bot利用許可とは別の設定です。
# ラベルID・名前・色はcalendar.listで確認します。同名だけでは自動登録しません。

DATABASE=var/agent.sqlite3
GOOGLE_TOKEN_FILE=var/google-token.json
GOOGLE_CLIENT_FILE=var/google-client-credentials.json
RETENTION_DAYS=7
APPROVAL_MINUTES=15
MAX_AI_CALLS_PER_DAY=30
MAX_READ_STEPS=4
CODEX_TIMEOUT_SECONDS=120
